{
  "name": "auteur",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "pip install --user -r requirements.txt && python -m auteur --version"
}
