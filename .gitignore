# auteur working directories
auteur-work/
auteur-web/
auteur-posts/
auteur-demo/

# The media index and the posting queue: local state about local footage,
# with absolute paths in them. Useful on the machine that made them and
# meaningless anywhere else.
auteur-library.json
auteur-schedule.json
demo/rushes/

# Accounts live beside the uploads, never in the repository. They hold
# password hashes and live session tokens.
accounts.json
**/accounts.json

# The phone app's icons and its palette stylesheet are generated at startup
# from auteur/theme.py, not checked in.
auteur/web/static/icon*.png
auteur/web/static/theme.css
*.mp4
*.mov
*.wav
*.mp3

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Performance exports: your account's data, not the project's.
auteur-exports/
auteur-practice-data.csv

# The published page, assembled by tools/artifact/build_artifact.py from the
# app's own markup plus the browser renderer. Generated, 190KB, and changes on
# every build — the sources are what is worth reviewing.
tools/artifact/auteur-app.html
