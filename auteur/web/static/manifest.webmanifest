{
  "id": "/",
  "name": "Atlas \u2014 the edit room",
  "short_name": "Atlas",
  "description": "Turn clips from your camera roll into a finished film.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#131110",
  "theme_color": "#131110",
  "categories": [
    "photo",
    "video",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Make a film",
      "short_name": "Create",
      "url": "/",
      "description": "Pick clips and say what kind of film"
    },
    {
      "name": "Feed",
      "short_name": "Feed",
      "url": "/feed",
      "description": "Films made here, newest first"
    },
    {
      "name": "Messages",
      "short_name": "Inbox",
      "url": "/inbox",
      "description": "Send a film to somebody"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "prompt",
      "files": [
        {
          "name": "clips",
          "accept": [
            "image/*",
            "video/*",
            "audio/*"
          ]
        }
      ]
    }
  },
  "prefer_related_applications": false
}
